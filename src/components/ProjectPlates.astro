---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import studyLightSchematic from "../assets/img/study-light-schematic.png";
import t7SkillTree from "../assets/img/t7-skill-tree.png";
import t7Extension from "../assets/img/t7-extension.png";

// A diagram is either an imported asset Astro can optimise, or an SVG served
// as-is from public/ — the narrowing below depends on which key it carries.
type Shot = { src: ImageMetadata; alt: string } | { url: string; alt: string };
interface Other {
  id: string;
  title: string;
  kind: string;
  meta: string;
  summary: string;
  facts: { label: string; value: string }[];
  notes: string[];
  technologies: string[];
  links: { label: string; href: string }[];
  gallery?: Shot[];
}

const entries = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const projects = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

const others: Other[] = [
  {
    id: "t7-learning-hub",
    title: "T7 Learning Hub",
    kind: "Web app, team build",
    meta: "Team of three, Mar – May 2026",
    summary:
      "A career-planning tool that reads a résumé against job descriptions and returns a ranked skill roadmap, with a Chrome extension that rates how useful a YouTube video is against the goal you set.",
    facts: [
      { label: "Team", value: "Three of us" },
      { label: "My commits", value: "3 of 11" },
      { label: "What I wrote", value: "674 lines" },
      { label: "Result", value: "Second place, Vibeathon" },
    ],
    notes: [
      "My part is the T7 Hub: a FastAPI router and the Next.js workspace page that drives it, 674 lines across the two. The router takes an uploaded résumé, pulls the text out with PyMuPDF, puts it to a language model against a target role, and writes the result back through Firebase.",
      "It is built on DeepTutor, an Apache-2.0 tutoring project from HKUDS that is vendored into the repository. The tutoring engine underneath is theirs; the hub on top of it is mine.",
      "The Chrome extension and the résumé scorer are my teammates' work. Of the eleven commits, six are Abhishek's and two are Bharath's.",
    ],
    technologies: ["React", "Vite", "FastAPI", "Next.js", "Firebase", "Gemini", "Tailwind"],
    links: [
      { label: "Live site", href: "https://t7skillup.vercel.app" },
      { label: "Source on GitHub", href: "https://github.com/Nithin0029/T7-Learning-Hub" },
    ],
    gallery: [
      { src: t7SkillTree, alt: "The career roadmap screen: skills ranked by priority for a Data Analyst role, each with an estimated time and a pending state, beside lists of skills already held and still to learn." },
      { src: t7Extension, alt: "The browser extension open beside a YouTube lesson, rating the video for quality and how well it matches the learner's goal, with a written summary underneath." },
    ],
  },
  {
    id: "smart-room",
    title: "Smart Room",
    kind: "Firmware, hardware",
    meta: "Sole developer, Sep 2026",
    summary:
      "Five ESP32 subsystems for one room: a relay on the tube light, a pair of servos that work the wall switch by hand, gas and climate sensing on a display, and a build that brings them together.",
    facts: [
      { label: "Subsystems", value: "5" },
      { label: "Firmware", value: "338 lines of C++" },
      { label: "Switched load", value: "230 V tube light" },
      { label: "Control", value: "SinricPro, Alexa / Google Home" },
      { label: "Commits", value: "6, all mine" },
    ],
    notes: [
      "The relay switches the live line through its normally-open contact, on purpose. If the ESP32 crashes or loses power the coil de-energises, the contact springs open and the light fails off rather than on. Neutral never passes through the relay at all, and the schematic says so in as many words.",
      "Two servos sit over the physical wall switch and press it, one for on and one for off, so the room still works for anyone who has never heard of the app. The press angles are still marked in the source as needing calibration against the real switch.",
      "An MQ-135 and a DHT22 report air quality, temperature and humidity to an SSD1306 display. The gas sensor reads on an ADC1 pin because ADC2 stops working once Wi-Fi is up — chosen before Wi-Fi was added, so the pin would not have to change later.",
      "SinricPro 5.x uses std::variant internally, which needs C++17, but the ESP32 Arduino core still compiles at -std=gnu++11. The build has to unset that flag before adding its own, or it fails inside the library rather than in my code.",
    ],
    technologies: ["C++17", "PlatformIO", "ESP32", "SinricPro", "DHT22", "MQ-135", "SSD1306"],
    links: [{ label: "Source on GitHub", href: "https://github.com/Nithin0029/Smart-Room" }],
    gallery: [
      { src: studyLightSchematic, alt: "Schematic for the tube light: mains through a breaker to the relay's normally-open contact, neutral running straight to the tube, and the ESP32 driving the relay over three low-voltage lines." },
      { url: "/diagrams/smart-room-main.svg", alt: "Schematic for the combined build, wiring the relay, both servos, the MQ-135, the DHT22 and the OLED to one ESP32." },
      { url: "/diagrams/smart-room-sensors.svg", alt: "Schematic for the sensor subsystem: MQ-135 on an ADC1 pin, DHT22, and an SSD1306 display over I2C." },
      { url: "/diagrams/smart-room-servo.svg", alt: "Schematic for the single-servo switch presser." },
      { url: "/diagrams/smart-room-servo-pair.svg", alt: "Schematic for the two-servo arrangement, one arm for on and one for off." },
    ],
  },
];

const fig = (i: number) => String(i + 1).padStart(2, "0");
---

<section class="sec wrap" id="work" aria-labelledby="work-title">
  <header class="sec__head">
    <h2 id="work-title">Selected work</h2>
    <p>Three I would defend in an interview. Open one.</p>
  </header>

  <ul class="plates" role="list">
    {
      projects.map(({ id, data }, i) => (
        <li style={`--i:${i}`}>
          <button class="plate" type="button" data-opens={`d-${id}`} aria-haspopup="dialog">
            <span class="plate__tab">
              <span class="plate__fig">Fig. {fig(i)}</span>
              <span class="plate__kind">{data.kind}</span>
            </span>

            <span class="plate__visual">
              {data.cover && data.cover.shape === "phones" ? (
                <span class="plate__phones">
                  {data.gallery.slice(0, 2).map((g) => (
                    <Picture src={g.src} alt="" widths={[180, 270]} sizes="7rem" formats={["avif", "webp"]} />
                  ))}
                </span>
              ) : data.cover ? (
                <Picture src={data.cover.src} alt="" widths={[360, 540]} sizes="(min-width: 48rem) 22rem, 88vw" formats={["avif", "webp"]} />
              ) : (
                <span class="plate__spec">
                  {data.facts.slice(0, 3).map((f) => (
                    <span class="plate__spec-row">
                      <span>{f.label}</span>
                      <b>{f.value}</b>
                    </span>
                  ))}
                </span>
              )}
            </span>

            <span class="plate__body">
              <span class="plate__title">{data.title}</span>
              <span class="plate__summary">{data.summary}</span>
              <span class="plate__chips">
                {data.technologies.slice(0, 3).map((t) => (
                  <span>{t}</span>
                ))}
                {data.technologies.length > 3 && <span class="plate__chips-rest">+{data.technologies.length - 3}</span>}
              </span>
              <span class="plate__open" aria-hidden="true">Open plate</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="also sd-rise">
    <h3 class="also__title">Also on GitHub</h3>
    <ul class="also__list" role="list">
      {
        others.map((o) => (
          <li>
            <button class="plate plate--small" type="button" data-opens={`d-${o.id}`} aria-haspopup="dialog">
              <span class="plate__tab">
                <span class="plate__kind">{o.kind}</span>
              </span>
              <span class="plate__body">
                <span class="plate__title">{o.title}</span>
                <span class="plate__summary">{o.summary}</span>
                <span class="plate__chips">
                  {o.technologies.slice(0, 3).map((t) => (
                    <span>{t}</span>
                  ))}
                </span>
                <span class="plate__open" aria-hidden="true">Open plate</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  projects.map(({ id, data, Content }, i) => {
    // the cover leads, then anything else the project has
    const shots = [
      ...(data.cover ? [{ src: data.cover.src, alt: data.cover.alt }] : []),
      ...data.gallery.filter((g) => !data.cover || g.src !== data.cover.src),
    ];
    return (
      <dialog class="sheet" id={`d-${id}`} aria-labelledby={`d-${id}-t`}>
        <div class="sheet__head">
          <div>
            <p class="sheet__kind">Fig. {fig(i)} — {data.kind}</p>
            <h3 id={`d-${id}-t`}>{data.title}</h3>
            <p class="sheet__meta">{data.role}, {data.period}</p>
          </div>
          <button class="sheet__x" type="button" data-close aria-label={`Close ${data.title}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>

        <div class="sheet__body">
          {shots.length > 0 && (
            <figure class="gal" data-gal>
              <div class={data.cover?.shape === "phones" ? "sheet__frame sheet__frame--tall" : "sheet__frame"}>
                {shots.map((g, n) => (
                  <div class="gal__slide" data-gal-slide hidden={n > 0}>
                    <Picture
                      src={g.src}
                      alt={g.alt}
                      widths={[480, 720]}
                      sizes="(min-width: 48rem) 34rem, 88vw"
                      formats={["avif", "webp"]}
                    />
                  </div>
                ))}
              </div>
              {shots.length > 1 && (
                <figcaption class="gal__bar">
                  <button class="gal__nav" type="button" data-gal-prev aria-label="Previous image">‹</button>
                  <span class="gal__count num" data-gal-count aria-live="polite">1 / {shots.length}</span>
                  <button class="gal__nav" type="button" data-gal-next aria-label="Next image">›</button>
                </figcaption>
              )}
            </figure>
          )}

          <p class="sheet__summary">{data.summary}</p>

          <dl class="sheet__facts">
            {data.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd class="num">{f.value}</dd>
              </div>
            ))}
          </dl>

          <div class="sheet__prose">
            <Content />
          </div>

          <div class="sheet__tech">
            <p class="sheet__tech-label">Built with</p>
            <ul role="list">
              {data.technologies.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>

          <div class="sheet__actions">
            {data.links.map((l, n) => (
              <a class:list={["btn", n === 0 && "btn--primary"]} href={l.href}>{l.label}</a>
            ))}
          </div>
        </div>
      </dialog>
    );
  })
}

{
  others.map((o) => (
    <dialog class="sheet" id={`d-${o.id}`} aria-labelledby={`d-${o.id}-t`}>
      <div class="sheet__head">
        <div>
          <p class="sheet__kind">{o.kind}</p>
          <h3 id={`d-${o.id}-t`}>{o.title}</h3>
          <p class="sheet__meta">{o.meta}</p>
        </div>
        <button class="sheet__x" type="button" data-close aria-label={`Close ${o.title}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <div class="sheet__body">
        {o.gallery && o.gallery.length > 0 && (
          <figure class="gal" data-gal>
            <div class="sheet__frame">
              {o.gallery.map((g, n) => (
                <div class="gal__slide" data-gal-slide hidden={n > 0}>
                  {"src" in g ? (
                    <Picture src={g.src} alt={g.alt} widths={[480, 720, 1080]} sizes="(min-width: 48rem) 34rem, 88vw" formats={["avif", "webp"]} />
                  ) : (
                    <img src={g.url} alt={g.alt} loading="lazy" decoding="async" />
                  )}
                </div>
              ))}
            </div>
            {o.gallery.length > 1 && (
              <figcaption class="gal__bar">
                <button class="gal__nav" type="button" data-gal-prev aria-label="Previous diagram">‹</button>
                <span class="gal__count num" data-gal-count aria-live="polite">1 / {o.gallery.length}</span>
                <button class="gal__nav" type="button" data-gal-next aria-label="Next diagram">›</button>
              </figcaption>
            )}
          </figure>
        )}

        <p class="sheet__summary">{o.summary}</p>

        <dl class="sheet__facts">
          {o.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd class="num">{f.value}</dd>
            </div>
          ))}
        </dl>

        {o.notes.length > 0 && (
          <div class="sheet__notes">
            <p class="sheet__tech-label">How it works</p>
            {o.notes.map((n) => (
              <p>{n}</p>
            ))}
          </div>
        )}

        <div class="sheet__tech">
          <p class="sheet__tech-label">Built with</p>
          <ul role="list">
            {o.technologies.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>

        <div class="sheet__actions">
          {o.links.map((l) => (
            <a class="btn btn--primary" href={l.href}>{l.label}</a>
          ))}
        </div>
      </div>
    </dialog>
  ))
}

<script>
  // Re-runs after every client-side navigation, because the ClientRouter
  // swaps the document and the listeners below go with it.
  const setup = () => {
    const root = document.documentElement;
    const dialogs = document.querySelectorAll<HTMLDialogElement>("dialog.sheet");
    if (!dialogs.length) return;
    let opener: HTMLElement | null = null;

    const lock = () => {
      const bar = window.innerWidth - root.clientWidth;
      root.style.setProperty("--sheet-gutter", `${bar}px`);
      root.classList.add("sheet-open");
    };
    const unlock = () => {
      root.classList.remove("sheet-open");
      root.style.removeProperty("--sheet-gutter");
    };

    // Idempotent, because it is reached from every route out of a dialog: the
    // close button, the backdrop, Escape, and the close event as a backstop.
    // Leaving the page locked because one hook failed to fire would strand the
    // visitor with a page they cannot scroll.
    const release = () => {
      unlock();
      const back = opener;
      opener = null;
      back?.focus();
    };

    document.querySelectorAll<HTMLButtonElement>("[data-opens]").forEach((card) => {
      card.addEventListener("click", () => {
        const sheet = document.getElementById(card.dataset.opens!) as HTMLDialogElement | null;
        if (!sheet) return;
        opener = card;
        lock();
        sheet.showModal();
      });
    });

    // Each gallery steps through its own slides. Hidden is toggled rather
    // than opacity, so only the shown image is in the accessibility tree and
    // nothing is left invisible if a style fails to load.
    document.querySelectorAll<HTMLElement>("[data-gal]").forEach((gal) => {
      const slides = [...gal.querySelectorAll<HTMLElement>("[data-gal-slide]")];
      const count = gal.querySelector<HTMLElement>("[data-gal-count]");
      if (slides.length < 2) return;
      let at = 0;
      const show = (next: number) => {
        at = (next + slides.length) % slides.length;
        slides.forEach((s, i) => (s.hidden = i !== at));
        if (count) count.textContent = `${at + 1} / ${slides.length}`;
      };
      gal.querySelector("[data-gal-prev]")?.addEventListener("click", () => show(at - 1));
      gal.querySelector("[data-gal-next]")?.addEventListener("click", () => show(at + 1));
      gal.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(at - 1);
        if (e.key === "ArrowRight") show(at + 1);
      });
    });

    dialogs.forEach((sheet) => {
      const dismiss = () => {
        sheet.close();
        release();
      };
      sheet.querySelector("[data-close]")?.addEventListener("click", dismiss);
      sheet.addEventListener("click", (e) => {
        if (e.target === sheet) dismiss();
      });
      sheet.addEventListener("cancel", release);
      sheet.addEventListener("close", release);
    });
  };

  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .plates {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  /* A plate: a drawing laid on the sheet, tabbed with its figure number. */
  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--raised);
    border: 1px solid var(--rule-2);
    border-radius: var(--radius);
    box-shadow: var(--lift);
    overflow: hidden;
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }
  .plate:is(:hover, :focus-visible) {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--lift-hover);
  }

  .plate__tab {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }
  .plate__fig {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .plate__kind {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .plate__visual {
    display: grid;
    place-items: center;
    height: 11rem;
    padding: var(--space-4);
    background: var(--ground);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .plate__visual :global(img) {
    max-height: 100%;
    width: auto;
    object-fit: contain;
    border: 1px solid var(--rule-2);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .plate:is(:hover, :focus-visible) .plate__visual :global(img) {
    transform: scale(1.04);
  }
  .plate__phones {
    display: flex;
    gap: var(--space-3);
    height: 100%;
    align-items: center;
  }
  .plate__phones :global(img) {
    max-height: 100%;
    width: auto;
  }
  .plate__spec {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .plate__spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
    color: var(--text-3);
  }
  .plate__spec-row b {
    color: var(--text);
    font-weight: 500;
  }

  .plate__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-5);
    flex: 1;
  }
  .plate__title {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    transition: color var(--dur-2) var(--ease-out);
  }
  .plate:is(:hover, :focus-visible) .plate__title {
    color: var(--accent);
  }
  .plate__summary {
    font-family: var(--prose);
    font-weight: 300;
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .plate__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .plate__chips span {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--ground);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .plate__chips .plate__chips-rest {
    border-style: dashed;
  }
  .plate__open {
    margin-top: auto;
    padding-top: var(--space-4);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* the drawings, mounted on the ground and stepped through one at a time */
  .gal {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .gal__slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    /* the diagrams are drawn on white, so they keep their own paper */
    background: #ffffff;
  }
  .gal__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .gal__nav {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius-sm);
    background: var(--ground);
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color var(--dur-1) linear,
      color var(--dur-1) linear;
  }
  .gal__nav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .gal__count {
    min-width: 4ch;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__nav {
      transition: none;
    }
  }
  .sheet__frame {
    padding: var(--space-3);
    background: var(--ground);
    border: 1px solid var(--rule-2);
    border-radius: var(--radius-sm);
  }
  .sheet__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .sheet__frame--tall :global(img) {
    width: min(100%, 17rem);
    margin-inline: auto;
  }
  .sheet__summary {
    margin: 0;
    font-family: var(--prose);
    font-weight: 300;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .sheet__facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .sheet__facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .sheet__facts dt {
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .sheet__facts dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
  }
  /* the project write-up, now that it has no page of its own */
  .sheet__prose {
    display: grid;
