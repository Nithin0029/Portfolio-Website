---
import { links, person } from "../data/site";

const subject = "Hello from your portfolio";
const mailto = `mailto:${links.email}?subject=${encodeURIComponent(subject)}`;
const gmail =
  "https://mail.google.com/mail/?view=cm&fs=1" +
  `&to=${encodeURIComponent(links.email)}` +
  `&su=${encodeURIComponent(subject)}`;
---

<section class="sec wrap" id="contact" aria-labelledby="contact-title">
  <header class="sec__head">
    <h2 id="contact-title">Contact</h2>
    <p>Hiring, or want to talk about a project? Email reaches me fastest.</p>
  </header>

  <div class="contact split">
    <div class="contact__mail sd-rise" data-copy-scope>
      <p class="contact__status-line">
        <span class="contact__dot" aria-hidden="true"></span>
        {person.availability}
      </p>
      <a class="contact__address" href={mailto}>{links.email}</a>
      <div class="contact__actions">
        <a class="btn btn--primary" href={mailto}>Write an email</a>
        <a class="btn" href={gmail} target="_blank" rel="noopener noreferrer">Open in Gmail</a>
        <button class="btn" type="button" data-copy={links.email}>
          <span data-copy-label>Copy address</span>
        </button>
        <p class="contact__status" role="status" data-copy-status></p>
      </div>
    </div>

    <div class="contact__aside sd-rise">
      <ul class="contact__links" role="list">
        <li>
          <a href={links.github}>
            <span>GitHub</span>
            <span class="contact__handle">@{links.githubHandle}</span>
          </a>
        </li>
        <li>
          <a href={links.linkedin}>
            <span>LinkedIn</span>
            <span class="contact__handle">Nithelan Jayakumar</span>
          </a>
        </li>
        <li>
          <a href={links.resume}>
            <span>Résumé</span>
            <span class="contact__handle">PDF, {links.resumeSize}</span>
          </a>
        </li>
      </ul>

      <dl class="contact__where">
        <div><dt>Based in</dt><dd>{person.location}</dd></div>
        <div><dt>Time zone</dt><dd class="num">UTC+05:30</dd></div>
        <div><dt>Replies</dt><dd>Within a day, usually</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>

  .contact__mail {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  /* the availability belongs here, where someone has decided to make contact */
  .contact__status-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .contact__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-0.05em);
  }

  .contact__address {
    display: inline-block;
    font-family: var(--display);
    text-transform: uppercase;
    font-weight: 600;
    font-size: clamp(1.3rem, 0.4rem + 2.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--rule-2);
    transition: border-color var(--dur-1) linear;
  }
  .contact__address:hover {
    border-color: currentColor;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .contact__status {
    color: var(--text-2);
    font-size: var(--step--1);
    min-width: 1px;
  }

  .contact__aside {
    display: grid;
    gap: var(--space-5);
  }
  .contact__links {
    margin: 0;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius);
    background: var(--raised);
    overflow: hidden;
  }
  .contact__links a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-weight: 500;
    text-decoration: none;
  }
  .contact__links li:last-child a {
    border-bottom: 0;
  }
  .contact__links a:hover {
    color: var(--accent);
  }
  .contact__handle {
    color: var(--text-2);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.8125rem;
  }

  /* what someone writing to me would want to know before they do */
  .contact__where {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .contact__where div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }
  .contact__where dt {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .contact__where dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
    text-align: right;
  }
</style>
